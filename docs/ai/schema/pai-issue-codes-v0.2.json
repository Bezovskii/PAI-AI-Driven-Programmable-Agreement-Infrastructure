{
  "registryVersion": "pai.issue-codes.v0.2",
  "targetSchemaVersion": "pai.agreement.v0.2",
  "description": "Stable semantic issue codes emitted by the PAI Agreement Model. This registry reports source-grounded extraction problems only.",
  "issueKinds": [
    {
      "kind": "missing_term",
      "evidenceRequired": false,
      "description": "A term needed to interpret the agreement is not stated in the source."
    },
    {
      "kind": "ambiguity",
      "evidenceRequired": true,
      "description": "The source supports more than one materially different interpretation."
    },
    {
      "kind": "contradiction",
      "evidenceRequired": true,
      "description": "Two or more explicit source statements cannot all be true as written."
    },
    {
      "kind": "unresolved_reference",
      "evidenceRequired": true,
      "description": "A source reference cannot be linked safely to a unique agreement entity or identifier."
    },
    {
      "kind": "unsupported_term",
      "evidenceRequired": true,
      "description": "The source states a term that Agreement Schema v0.2 cannot represent without invention or loss."
    }
  ],
  "codes": [
    {
      "code": "MISSING_PARTY",
      "kind": "missing_term",
      "description": "No party is stated for a required agreement role.",
      "pathPrefixes": [
        "/agreement/parties"
      ],
      "evidenceRequired": false
    },
    {
      "code": "MISSING_SCOPE",
      "kind": "missing_term",
      "description": "The work or exchange scope is not stated.",
      "pathPrefixes": [
        "/agreement/scope"
      ],
      "evidenceRequired": false
    },
    {
      "code": "MISSING_DELIVERABLE",
      "kind": "missing_term",
