{
  "name": "pai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "test": "node --import tsx --test test/health.test.ts test/readiness.test.ts test/database.integration.test.ts test/auth.nonce.test.ts test/auth.verify.test.ts test/auth.session.test.ts test/auth.login.test.ts test/auth.lifecycle.test.ts test/agreements.routes.test.ts test/agreements.service.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "pretypecheck": "prisma generate",
    "pretest": "prisma generate",
    "prebuild": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "fastify": "^5.11.3",
    "pg": "^8.23.0",
    "siwe": "^3.0.0",
    "typebox": "^1.3.13"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
