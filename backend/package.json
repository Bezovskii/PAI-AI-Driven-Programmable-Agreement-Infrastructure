{
  "name": "esct-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "test": "node --import tsx --test test/health.test.ts"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.1.0",
    "fastify": "^5.11.3",
    "typebox": "^1.3.13"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
